+  //        b0 b1
+  //     d0 e0 e1 f0
+  //     d1 e2 e3 f1
+  //        h0 h1
+  vec3 b0 = fetch_texel(o + ivec2(0, -1)), b1 = fetch_texel(o + ivec2(1, -1));
+  vec3 d0 = fetch_texel(o + ivec2(-1, 0)), d1 = fetch_texel(o + ivec2(-1, 1));
+  vec3 e0 = fetch_texel(o + ivec2(0, 0)),  e1 = fetch_texel(o + ivec2(1, 0));
+  vec3 e2 = fetch_texel(o + ivec2(0, 1)),  e3 = fetch_texel(o + ivec2(1, 1));
+  vec3 f0 = fetch_texel(o + ivec2(2, 0)),  f1 = fetch_texel(o + ivec2(2, 1));
+  vec3 h0 = fetch_texel(o + ivec2(0, 2)),  h1 = fetch_texel(o + ivec2(1, 2));
