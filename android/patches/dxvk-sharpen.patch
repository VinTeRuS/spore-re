+layout(constant_id = 6) const uint c_sharpen = 0u;
+
 layout(location = 0) in  vec2 i_coord;
 layout(location = 0) out vec4 o_color;
 
+vec3 fetch_texel(ivec2 p) {
+  p = clamp(p, src_offset, src_offset + src_extent - ivec2(1));
+  return texelFetch(s_image, p, 0).rgb;
+}
+
+vec3 cas(vec3 b, vec3 d, vec3 e, vec3 f, vec3 h, float peak) {
+  vec3 mn = min(min(min(d, e), min(f, b)), h);
+  vec3 mx = max(max(max(d, e), max(f, b)), h);
+  vec3 amp = sqrt(clamp(min(mn, vec3(2.0) - mx) / max(mx, vec3(1.0f / 65536.0f)), 0.0, 1.0));
+  vec3 w = amp * peak;
+  return clamp(((b + d + f + h) * w + e) / (vec3(1.0) + 4.0 * w), 0.0, 1.0);
+}
