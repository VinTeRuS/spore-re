diff -ruN a/src/util/util_vector.h b/src/util/util_vector.h
--- a/src/util/util_vector.h	2022-07-27 00:45:31.000000000 +0300
+++ b/src/util/util_vector.h	2026-11-14 16:12:25.713031037 +0200
@@ -151,10 +151,15 @@
 
   inline Vector4 replaceNaN(Vector4 a) {
     Vector4 result;
+#if defined(__i386__) || defined(__x86_64__)
     __m128 value = _mm_load_ps(a.data);
     __m128 mask  = _mm_cmpeq_ps(value, value);
            value = _mm_and_ps(value, mask);
     _mm_store_ps(result.data, value);
+#else
+    for (int i = 0; i < 4; i++)
+      result.data[i] = a.data[i] == a.data[i] ? a.data[i] : 0.0f;
+#endif
     return result;
   }
 
