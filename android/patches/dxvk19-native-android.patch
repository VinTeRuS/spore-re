+      vki->sym("vkCreateAndroidSurfaceKHR"));
+    if (!create)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    SporeAndroidSurfaceCreateInfo ci = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    ci.window = info.info.android.window;
+    return create(vki->instance(), &ci, nullptr, pSurface);
+#endif
+
     return SDL_Vulkan_CreateSurface(window, vki->instance(), pSurface)
          ? VK_SUCCESS
          : VK_ERROR_OUT_OF_HOST_MEMORY;
