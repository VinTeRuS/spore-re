diff -ruN a/src/util/sync/sync_spinlock.h b/src/util/sync/sync_spinlock.h
--- a/src/util/sync/sync_spinlock.h	2022-07-27 00:45:31.000000000 +0300
+++ b/src/util/sync/sync_spinlock.h	2026-11-14 16:12:25.713148213 +0200
@@ -21,7 +21,11 @@
   void spin(uint32_t spinCount, const Fn& fn) {
     while (unlikely(!fn())) {
       for (uint32_t i = 1; i < spinCount; i++) {
+#if defined(__i386__) || defined(__x86_64__)
         _mm_pause();
+#elif defined(__aarch64__)
+        __asm__ __volatile__("yield");
+#endif
         if (fn())
           return;
       }
